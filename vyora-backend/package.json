{
  "name": "vyora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vyora Version 1 — Standalone Backend REST API Monolith (Node.js + Express.js + MongoDB + Mongoose)",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^3.0.7"
  }
}
