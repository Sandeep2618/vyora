{
  "name": "vyora",
  "version": "1.0.0",
  "private": true,
  "description": "Vyora — Small Business Billing & Management Project Root (vyora-backend, vyora-frontend, and future vyora-mobile)",
  "scripts": {
    "start:backend": "pnpm --dir vyora-backend start",
    "dev:backend": "pnpm --dir vyora-backend dev",
    "dev:frontend": "pnpm --dir vyora-frontend dev",
    "test:backend": "pnpm --dir vyora-backend test",
    "test:frontend": "pnpm --dir vyora-frontend test",
    "test": "pnpm test:backend && pnpm test:frontend",
    "typecheck:backend": "pnpm --dir vyora-backend typecheck",
    "typecheck:frontend": "pnpm --dir vyora-frontend typecheck",
    "typecheck": "pnpm typecheck:backend && pnpm typecheck:frontend",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-unknown",
    "format:fix": "npx prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-unknown",
    "test:qa": "node scripts/qa-runner.js",
    "check-secrets": "node scripts/check-secrets.js",
    "audit:ui": "node scripts/audit-ui.js",
    "db:seed": "node scripts/seed-data.js",
    "ship:check": "node scripts/ship-check.js"
  }
}
